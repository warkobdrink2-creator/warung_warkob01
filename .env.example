# Konfigurasi Supabase (Client-side - Aman untuk browser dengan RLS aktif)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Alternatif prefix jika menggunakan Next.js / Vercel template
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server-only secret (JANGAN PERNAH diekspos ke frontend / repository)
SUPABASE_SERVICE_ROLE_KEY=""

# Session secret untuk server-side auth lokal
SESSION_SECRET="antrian-warung-dev-secret-change-in-production"

# URL aplikasi
APP_URL="http://localhost:3000"
